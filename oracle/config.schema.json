{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sovereign deployment-specific runtime configuration",
  "type": "array",
  "minItems": 2,
  "maxItems": 2,
  "items": {
    "type": "object",
    "properties": {
      "chain_id": {
        "enum": [
          8453,
          42161
        ]
      },
      "router": {
        "type": "string",
        "pattern": "^0x[0-9a-fA-F]{40}$"
      },
      "pool": {
        "type": "string",
        "pattern": "^0x[0-9a-fA-F]{40}$"
      },
      "tip_wei": {
        "type": "string",
        "pattern": "^[1-9][0-9]*$",
        "maxLength": 78
      },
      "max_tip_wei": {
        "type": "string",
        "pattern": "^[1-9][0-9]*$",
        "maxLength": 78
      },
      "max_fee_wei": {
        "type": "string",
        "pattern": "^[1-9][0-9]*$",
        "maxLength": 78
      },
      "l1_fee_reserve_wei": {
        "type": "string",
        "pattern": "^[1-9][0-9]*$",
        "maxLength": 78
      },
      "max_tx_cost_wei": {
        "type": "string",
        "pattern": "^[1-9][0-9]*$",
        "maxLength": 78
      },
      "max_premium_bps": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100
      },
      "native_usd_feed": {
        "type": "string",
        "pattern": "^0x[0-9a-fA-F]{40}$"
      },
      "subscribe_pending": {
        "type": "boolean"
      },
      "routes": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "asset": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{40}$"
            },
            "amount": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$",
              "maxLength": 78
            },
            "min_margin_bps": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000
            },
            "slippage_bps": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "loan_usd_feed": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{40}$"
            },
            "rwa_nav_feed": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{40}$"
            },
            "feed_max_age": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            },
            "loan_decimals": {
              "type": "integer",
              "minimum": 0,
              "maximum": 36
            },
            "rwa_decimals": {
              "type": "integer",
              "minimum": 0,
              "maximum": 36
            },
            "min_nav_discount_bps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9999
            },
            "legs": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "object",
                "properties": {
                  "router": {
                    "type": "string",
                    "pattern": "^0x[0-9a-fA-F]{40}$"
                  },
                  "quoter": {
                    "type": "string",
                    "pattern": "^0x[0-9a-fA-F]{40}$"
                  },
                  "token_in": {
                    "type": "string",
                    "pattern": "^0x[0-9a-fA-F]{40}$"
                  },
                  "token_out": {
                    "type": "string",
                    "pattern": "^0x[0-9a-fA-F]{40}$"
                  },
                  "fee": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 999999
                  },
                  "kind": {
                    "enum": [
                      1,
                      2
                    ]
                  }
                },
                "required": [
                  "router",
                  "quoter",
                  "token_in",
                  "token_out",
                  "fee",
                  "kind"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "id",
            "asset",
            "amount",
            "min_margin_bps",
            "slippage_bps",
            "loan_usd_feed",
            "rwa_nav_feed",
            "feed_max_age",
            "loan_decimals",
            "rwa_decimals",
            "min_nav_discount_bps",
            "legs"
          ],
          "additionalProperties": false
        }
      },
      "confirmations": {
        "type": "integer",
        "minimum": 1,
        "maximum": 64
      }
    },
    "required": [
      "chain_id",
      "router",
      "pool",
      "tip_wei",
      "max_tip_wei",
      "max_fee_wei",
      "l1_fee_reserve_wei",
      "max_tx_cost_wei",
      "max_premium_bps",
      "native_usd_feed",
      "subscribe_pending",
      "routes",
      "confirmations"
    ],
    "additionalProperties": false
  }
}
